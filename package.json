{
  "name": "matsne-app",
  "version": "1.0.5",
  "description": "Fullscreen desktop app for matsne.gov.ge",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder -mw",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "ge.gov.matsne.desktop",
    "productName": "Matsne",
    "afterPack": "build/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "home.html",
      "favorites.html",
      "document.html",
      "assets/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.reference",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Matsne",
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^25.1.8"
  }
}
